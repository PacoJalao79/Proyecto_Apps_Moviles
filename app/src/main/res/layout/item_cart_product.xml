<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <ImageView
        android:id="@+id/product_image_cart"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@tools:sample/backgrounds/scenic" />

    <TextView
        android:id="@+id/product_name_cart"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
        app:layout_constraintStart_toEndOf="@id/product_image_cart"
        app:layout_constraintTop_toTopOf="@id/product_image_cart"
        app:layout_constraintEnd_toStartOf="@id/remove_item_button"
        tools:text="Nombre del Producto" />

    <TextView
        android:id="@+id/product_price_cart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary"
        app:layout_constraintStart_toStartOf="@id/product_name_cart"
        app:layout_constraintTop_toBottomOf="@id/product_name_cart"
        tools:text="$99.99" />

    <!-- Controles de cantidad -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/decrease_quantity_button"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="-"
        android:textSize="16sp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:layout_constraintStart_toStartOf="@id/product_name_cart"
        app:layout_constraintTop_toBottomOf="@id/product_price_cart"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/quantity_text"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/decrease_quantity_button"
        app:layout_constraintEnd_toStartOf="@id/increase_quantity_button"
        app:layout_constraintTop_toTopOf="@id/decrease_quantity_button"
        app:layout_constraintBottom_toBottomOf="@id/decrease_quantity_button"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        tools:text="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/increase_quantity_button"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="+"
        android:textSize="16sp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:layout_constraintStart_toEndOf="@id/quantity_text"
        app:layout_constraintTop_toTopOf="@id/decrease_quantity_button" />

    <ImageButton
        android:id="@+id/remove_item_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_cancel"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Eliminar producto"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
